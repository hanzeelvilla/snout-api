{
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-ts.js",
            "statusMessage": "Formatting with Prettier..."
          }
        ]
      }
    ]
  }
}
